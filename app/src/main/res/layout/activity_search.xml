<?xml version="1.0" encoding="utf-8"?>
<!-- SearchActivity: opened when the user taps the search icon (home search bar or bottom nav) -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Search bar header -->
    <LinearLayout
        android:id="@+id/ll_search_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/primary"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/ib_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back"
            app:tint="@color/white" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_search_bar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_search"
                app:tint="@color/text_hint" />

            <EditText
                android:id="@+id/et_search"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="Tìm sách, tác giả, NXB..."
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:textSize="14sp" />

            <ImageButton
                android:id="@+id/ib_clear_search"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_close_circle"
                android:visibility="gone"
                app:tint="@color/text_hint" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_cancel_search"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:padding="6dp"
            android:text="Huỷ"
            android:textColor="@color/white"
            android:textSize="13sp" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/ll_search_header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ===== BROWSE MODE: shown before the user types / selects anything ===== -->
            <LinearLayout
                android:id="@+id/ll_browse_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="16dp">

                <!-- Recent searches -->
                <LinearLayout
                    android:id="@+id/ll_recent_searches"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Tìm kiếm gần đây"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_clear_recent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Xoá hết"
                            android:textColor="@color/primary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_recent_searches"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:clipToPadding="false"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
                </LinearLayout>

                <!-- Popular keywords -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="16dp"
                        android:text="Từ khoá phổ biến"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_popular_keywords"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:clipToPadding="false"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
                </LinearLayout>

                <!-- Category browse grid -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="22dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="16dp"
                        android:text="Tìm theo thể loại"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_search_categories"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:nestedScrollingEnabled="false"
                        android:paddingHorizontal="10dp"
                        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                        app:spanCount="3" />
                </LinearLayout>
            </LinearLayout>

            <!-- ===== RESULT MODE: shown once user types a keyword or taps a category ===== -->
            <LinearLayout
                android:id="@+id/ll_result_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Active category / keyword breadcrumb -->
                <LinearLayout
                    android:id="@+id/ll_active_filter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="14dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tv_active_category_chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_sale"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="5dp"
                        android:text="Kỹ năng sống  ✕"
                        android:textColor="@color/accent_price"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Sort / filter chips -->
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/cg_sort_options"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:paddingHorizontal="12dp"
                    app:chipSpacingHorizontal="6dp"
                    app:singleLine="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_sort_relevance"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="Liên quan"
                        android:textColor="@color/chip_sort_text_selector"
                        android:textSize="12sp"
                        app:chipBackgroundColor="@color/chip_sort_bg_selector"
                        app:chipStrokeColor="@color/divider"
                        app:chipStrokeWidth="1dp"
                        app:textEndPadding="10dp"
                        app:textStartPadding="10dp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_sort_bestseller"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mua nhiều nhất"
                        android:textColor="@color/chip_sort_text_selector"
                        android:textSize="12sp"
                        app:chipBackgroundColor="@color/chip_sort_bg_selector"
                        app:chipIcon="@drawable/ic_trending"
                        app:chipIconTint="@color/chip_sort_icon_selector"
                        app:chipIconVisible="true"
                        app:chipStrokeColor="@color/divider"
                        app:chipStrokeWidth="1dp"
                        app:textEndPadding="10dp"
                        app:textStartPadding="6dp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_sort_rating"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Đánh giá cao nhất"
                        android:textColor="@color/chip_sort_text_selector"
                        android:textSize="12sp"
                        app:chipBackgroundColor="@color/chip_sort_bg_selector"
                        app:chipIcon="@drawable/ic_star"
                        app:chipIconTint="@color/chip_sort_icon_selector"
                        app:chipIconVisible="true"
                        app:chipStrokeColor="@color/divider"
                        app:chipStrokeWidth="1dp"
                        app:textEndPadding="10dp"
                        app:textStartPadding="6dp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_sort_price_asc"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Giá thấp → cao"
                        android:textColor="@color/chip_sort_text_selector"
                        android:textSize="12sp"
                        app:chipBackgroundColor="@color/chip_sort_bg_selector"
                        app:chipStrokeColor="@color/divider"
                        app:chipStrokeWidth="1dp"
                        app:textEndPadding="10dp"
                        app:textStartPadding="10dp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_sort_price_desc"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Giá cao → thấp"
                        android:textColor="@color/chip_sort_text_selector"
                        android:textSize="12sp"
                        app:chipBackgroundColor="@color/chip_sort_bg_selector"
                        app:chipStrokeColor="@color/divider"
                        app:chipStrokeWidth="1dp"
                        app:textEndPadding="10dp"
                        app:textStartPadding="10dp" />
                </com.google.android.material.chip.ChipGroup>

                <TextView
                    android:id="@+id/tv_result_count"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:paddingHorizontal="16dp"
                    android:text="Tìm thấy 24 kết quả"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_search_results"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginHorizontal="10dp"
                    android:nestedScrollingEnabled="false"
                    android:paddingBottom="16dp"
                    app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                    app:spanCount="2" />
            </LinearLayout>

            <!-- Empty result state -->
            <LinearLayout
                android:id="@+id/ll_empty_search"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="40dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:src="@drawable/ic_search_off"
                    app:tint="@color/text_hint" />

                <TextView
                    android:id="@+id/tv_empty_search_message"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center"
                    android:text="Không tìm thấy kết quả phù hợp.\nThử từ khoá khác hoặc chọn thể loại bên dưới."
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Loading -->
    <ProgressBar
        android:id="@+id/pb_search_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminateTint="@color/primary"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/ll_search_header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
