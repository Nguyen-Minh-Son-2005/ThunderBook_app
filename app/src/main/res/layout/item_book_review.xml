<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="12dp">

    <!-- Header: ảnh avatar + tên + ngày -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/iv_user_avatar"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:scaleType="centerCrop"
            android:src="@drawable/placeholder_avatar" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_user_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tên người dùng"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_review_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="10/08/2026"
                android:textColor="@color/text_hint"
                android:textSize="12sp" />
        </LinearLayout>
        
        <!-- Sao -->
        <LinearLayout
            android:id="@+id/ll_stars_display"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView android:layout_width="14dp" android:layout_height="14dp" android:layout_marginEnd="1dp" android:src="@drawable/ic_star" app:tint="@color/star_rating" />
            <ImageView android:layout_width="14dp" android:layout_height="14dp" android:layout_marginEnd="1dp" android:src="@drawable/ic_star" app:tint="@color/star_rating" />
            <ImageView android:layout_width="14dp" android:layout_height="14dp" android:layout_marginEnd="1dp" android:src="@drawable/ic_star" app:tint="@color/star_rating" />
            <ImageView android:layout_width="14dp" android:layout_height="14dp" android:layout_marginEnd="1dp" android:src="@drawable/ic_star" app:tint="@color/star_rating" />
            <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/ic_star" app:tint="@color/divider" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tv_comment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Nội dung đánh giá"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="@color/divider" />
</LinearLayout>
