<?xml version="1.0" encoding="utf-8"?>
<!-- item_my_review: dùng trong rv_my_reviews -->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginTop="12dp"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Header: ảnh sách + tên + ngày -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_book_cover"
                android:layout_width="40dp"
                android:layout_height="54dp"
                android:scaleType="centerCrop"
                android:src="@drawable/placeholder_book" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_book_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Nhà Giả Kim"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_review_date"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Đã đánh giá · 10/08/2026"
                    android:textColor="@color/text_hint"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_delete_review"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="6dp"
                android:text="Xóa"
                android:textColor="@color/status_error"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Số sao đã đánh giá (chỉ hiển thị, không cho sửa) -->
        <LinearLayout
            android:id="@+id/ll_stars_display"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:layout_marginEnd="2dp" android:src="@drawable/ic_star" app:tint="@color/star_rating" />
            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:layout_marginEnd="2dp" android:src="@drawable/ic_star" app:tint="@color/star_rating" />
            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:layout_marginEnd="2dp" android:src="@drawable/ic_star" app:tint="@color/star_rating" />
            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:layout_marginEnd="2dp" android:src="@drawable/ic_star" app:tint="@color/star_rating" />
            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_star" app:tint="@color/divider" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_comment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Sách hay, giao hàng nhanh, đóng gói cẩn thận. Rất đáng đọc!"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <!-- Phản hồi từ admin (nếu có) -->
        <LinearLayout
            android:id="@+id/ll_admin_reply"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@color/background"
            android:orientation="vertical"
            android:padding="10dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Phản hồi từ Trang Sách:"
                android:textColor="@color/primary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_admin_reply_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Cảm ơn bạn đã ủng hộ shop!"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
