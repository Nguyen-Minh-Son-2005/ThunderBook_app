<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <include layout="@layout/admin_toolbar_admin" />
    <!-- tv_toolbar_title: "Chi tiết người dùng" -->

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- HEADER THÔNG TIN USER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_gradient_header"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="@dimen/spacing_lg">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/iv_detail_avatar"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@drawable/bg_thumbnail_placeholder"
                    android:scaleType="centerCrop"
                    app:strokeColor="@color/white"
                    app:strokeWidth="2dp"
                    app:shapeAppearanceOverlay="@style/CircleImageViewStyle" />

                <TextView
                    android:id="@+id/tv_detail_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:text="Nguyễn Văn A"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_detail_email"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="nguyenvana@gmail.com"
                    android:textColor="#CCE3F2FD"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- ĐỔI QUYỀN -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/spacing_md"
                android:background="@drawable/bg_rounded_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/spacing_md">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Quyền quản trị"
                        style="@style/Text.Body" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cấp quyền admin cho tài khoản này"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/sw_grant_admin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:thumbTint="@color/primary" />
            </LinearLayout>

            <!-- LỊCH SỬ ĐƠN HÀNG -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_md"
                android:text="Lịch sử đơn hàng (14)"
                style="@style/Text.Heading2" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_user_orders"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/spacing_md"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/admin_item_admin_order"
                xmlns:tools="http://schemas.android.com/tools" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
