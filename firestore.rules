rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Function: Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Function: Check if user is Admin
    function isAdmin() {
      return isAuthenticated() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Function: Check if the document belongs to the authenticated user
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Collection: users
    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }
    
    // Collection: books, authors, categories, publishers
    match /books/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /authors/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /categories/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /publishers/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Collection: vouchers
    match /vouchers/{document=**} {
      // Allow everyone to read so they can apply vouchers
      allow read: if true; 
      allow write: if isAdmin();
    }
    
    // Collection: orders
    match /orders/{orderId} {
      // User can read their own orders. Admin can read all.
      allow read: if isOwner(resource.data.userId) || isAdmin();
      
      // User can create orders.
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      
      // Admin can update/delete orders. User can update (e.g. cancel) their own order.
      allow update: if isAdmin() || isOwner(resource.data.userId);
      allow delete: if isAdmin();
    }
    
    // Collection: reviews
    match /reviews/{reviewId} {
      // Anyone can read reviews
      allow read: if true;
      
      // Users can create/update their own reviews
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin() || isOwner(resource.data.userId);
    }
    
    // Collection: notifications
    match /notifications/{userId}/userNotifications/{notificationId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }
    
    // Collection: carts
    match /carts/{userId} {
      allow read, write: if isOwner(userId);
    }
    
  }
}
